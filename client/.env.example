# ==============================================================
# Client Environment Variables — Smart Complaint Service Platform
# ==============================================================
# Copy this file to .env and fill in the values.
# For Vercel: set these in the Vercel dashboard under
#   Project → Settings → Environment Variables
# ==============================================================

# The full URL of your deployed backend API (no trailing slash)
# Local:       http://localhost:5000/api
# Production:  https://your-backend.railway.app/api
VITE_API_URL=http://localhost:5000/api

# The root URL of your backend for Socket.io (no trailing slash)
# Local:       http://localhost:5000
# Production:  https://your-backend.railway.app
VITE_SOCKET_URL=http://localhost:5000
